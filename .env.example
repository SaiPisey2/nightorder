# Copy to .env and fill in. .env is gitignored — never commit real values.
# Load with:  set -a; source .env; set +a

# --- core ---------------------------------------------------------------
NIGHTORDER_DATABASE_URL=postgresql+asyncpg://nightorder:nightorder@localhost:5433/nightorder
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
NIGHTORDER_API_BASE_URL=http://localhost:8400
NIGHTORDER_API_PORT=8400
# Loopback by default. Set 0.0.0.0 only when something in front enforces access.
NIGHTORDER_API_HOST=127.0.0.1

# --- gates --------------------------------------------------------------
# HMAC key for signed single-use gate action links. Generate a real one:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
NIGHTORDER_GATE_TOKEN_SECRET=dev-only-secret-change-me
NIGHTORDER_GATE_TOKEN_TTL_SECONDS=86400

# --- AI advisory (optional; without a key the advisory half is disabled) --
ANTHROPIC_API_KEY=
NIGHTORDER_ADVISOR_MODEL=claude-sonnet-5
NIGHTORDER_QDRANT_URL=http://localhost:6333

# --- kubernetes ---------------------------------------------------------
# Empty = current kubectl context. Set this explicitly if your current
# context points somewhere you do not want a workflow submitted.
NIGHTORDER_KUBE_CONTEXT=
NIGHTORDER_ARGO_NAMESPACE=argo
NIGHTORDER_MANIFESTS_DIR=manifests
NIGHTORDER_SANDBOX_NAMESPACE=nightorder-e2e

# --- outbound requests ---------------------------------------------------
# Gate webhooks are refused if they resolve to loopback, link-local (where the
# cloud metadata service lives), multicast or reserved addresses. Set to 1 to
# permit loopback and link-local for local development.
NIGHTORDER_ALLOW_LOCAL_WEBHOOKS=

# --- ssh (remote_exec executor) -----------------------------------------
# Host keys are verified against ~/.ssh/known_hosts by default. Point this at
# a specific file, or set the insecure flag to skip verification entirely.
NIGHTORDER_SSH_KNOWN_HOSTS=
NIGHTORDER_SSH_INSECURE_NO_HOST_KEY_CHECK=

# --- notifications (optional) -------------------------------------------
NIGHTORDER_TEAMS_WEBHOOK_URL=
NIGHTORDER_TEAMS_ALERT_EVENTS=WorkflowFailed,GateRequested,RemediationSuggested,GateExpired
NIGHTORDER_TEAMS_ALERT_MENTIONS=

# --- auth (open platform by default) ------------------------------------
NIGHTORDER_AUTH=off
NIGHTORDER_ADMIN_KEY=
