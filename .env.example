# Copy to .env and fill in. .env is gitignored — never commit real values.
# Load with:  set -a; source .env; set +a

# --- core ---------------------------------------------------------------
BOSUN_DATABASE_URL=postgresql+asyncpg://bosun:bosun@localhost:5433/bosun
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
BOSUN_API_BASE_URL=http://localhost:8400
BOSUN_API_PORT=8400

# --- gates --------------------------------------------------------------
# HMAC key for signed single-use gate action links. Generate a real one:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BOSUN_GATE_TOKEN_SECRET=dev-only-secret-change-me
BOSUN_GATE_TOKEN_TTL_SECONDS=86400

# --- AI advisory (optional; without a key the advisory half is disabled) --
ANTHROPIC_API_KEY=
BOSUN_ADVISOR_MODEL=claude-sonnet-5
BOSUN_QDRANT_URL=http://localhost:6333

# --- kubernetes ---------------------------------------------------------
# Empty = current kubectl context. Set this explicitly if your current
# context points somewhere you do not want a workflow submitted.
BOSUN_KUBE_CONTEXT=
BOSUN_ARGO_NAMESPACE=argo
BOSUN_MANIFESTS_DIR=manifests
BOSUN_SANDBOX_NAMESPACE=bosun-e2e

# --- notifications (optional) -------------------------------------------
BOSUN_TEAMS_WEBHOOK_URL=
BOSUN_TEAMS_ALERT_EVENTS=WorkflowFailed,GateRequested,RemediationSuggested,GateExpired
BOSUN_TEAMS_ALERT_MENTIONS=

# --- auth (open platform by default) ------------------------------------
BOSUN_AUTH=off
BOSUN_ADMIN_KEY=
